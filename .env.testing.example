# Isolated test environment. Use only disposable data and test accounts.
APP_ENV=testing
PORT=5010
SECRET_KEY=local-test-only-secret-do-not-reuse
ADMIN_USERNAME=test-owner
ADMIN_PASSWORD=local-test-only-password
DATABASE_URL=sqlite:///drone_portal_test.db
SESSION_COOKIE_SECURE=0
MAX_CONTENT_LENGTH=8589934592

# External services are mocked by the automated tests. Never use live values here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Capture IV <no-reply@example.test>
ENTERPRISE_INQUIRY_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STORAGE_BACKEND=local
