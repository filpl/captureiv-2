@@ -0,0 +1,30 @@
+/* Capture IV legal and policy pages */
+:root { --ink: #0b1530; --text: #334155; --muted: #64748b; --line: #dbe3ef; --blue: #2563eb; --bg: #f5f7fb; }
+* { box-sizing: border-box; }
+body.legal-page { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.65 Inter, system-ui, -apple-system, "Segoe UI", sans-serif; }
+.skip-link { position: absolute; left: -9999px; top: 8px; padding: 8px 12px; background: #fff; color: var(--ink); border-radius: 8px; }
+.skip-link:focus { left: 12px; z-index: 10; }
+a { color: var(--blue); }
+.legal-top { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding: 18px clamp(16px, 4vw, 48px); background: #fff; border-bottom: 1px solid var(--line); }
+.legal-brand { color: var(--ink); font: 800 20px/1 Manrope, Inter, system-ui, sans-serif; letter-spacing: -.03em; text-decoration: none; }
+.legal-brand span { color: var(--blue); }
+.legal-top nav { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
+.legal-top nav a { color: var(--text); text-decoration: none; }
+.legal-top nav a[aria-current="page"] { color: var(--blue); font-weight: 600; }
+.legal-main { max-width: 820px; margin: 0 auto; padding: clamp(24px, 5vw, 56px) 16px 64px; }
+.legal-draft { margin: 0 0 20px; padding: 12px 16px; border: 1px solid #f3d38b; border-radius: 12px; background: #fff8e6; color: #6b4e09; font-size: 14px; }
+.legal-doc { padding: clamp(20px, 4vw, 44px); border: 1px solid var(--line); border-radius: 16px; background: #fff; }
+.legal-eyebrow { margin: 0 0 6px; color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
+.legal-doc h1 { margin: 0 0 6px; color: var(--ink); font: 800 clamp(28px, 4vw, 38px)/1.15 Manrope, Inter, system-ui, sans-serif; letter-spacing: -.02em; }
+.legal-meta { margin: 0 0 24px; color: var(--muted); font-size: 14px; }
+.legal-doc h2 { margin: 28px 0 8px; color: var(--ink); font-size: 19px; }
+.legal-doc ul, .legal-doc ol { padding-left: 22px; }
+.legal-doc li { margin: 4px 0; }
+.legal-table { width: 100%; border-collapse: collapse; margin: 8px 0 12px; font-size: 15px; }
+.legal-table th, .legal-table td { padding: 10px 12px; border: 1px solid var(--line); text-align: left; vertical-align: top; }
+.legal-table th { background: #f1f5fb; color: var(--ink); }
+.legal-contact { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); }
+.legal-list li { margin: 8px 0; }
+.legal-foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; padding: 24px 16px 40px; font-size: 14px; }
+.legal-foot a { color: var(--muted); }
+@media (max-width: 600px) { .legal-table, .legal-table tbody, .legal-table tr, .legal-table td { display: block; width: 100%; } .legal-table thead { display: none; } .legal-table td { border-top: 0; } .legal-table tr { border-top: 1px solid var(--line); } }
