+@app.get("/legal/<slug>")
+def legal_page(slug):
+    if slug not in LEGAL_PAGES:
+        abort(404)
+    return render_template(f"legal/{slug}.html", legal=legal_details(), title=LEGAL_PAGES[slug], slug=slug)
+
