diff --git a/static/viewer-refresh.css b/static/viewer-refresh.css
index 38a0070..24ca50f 100644
--- a/static/viewer-refresh.css
+++ b/static/viewer-refresh.css
@@ -129,3 +129,5 @@ body.viewer-page .date-rail :is(a, button, .date-item, li).selected,
 body.viewer-page .date-rail :is(a, button, .date-item, li).active,
 body.viewer-page .date-rail [aria-current] { background: var(--vr-blue-soft) !important; color: #1d5fd6; border-color: transparent; }
 body.viewer-page .eyebrow { color: #2f6fe0; }
+body.viewer-page .date-rail .date-item.current { background: var(--vr-blue-soft) !important; color: #1d5fd6; border-color: transparent; }
+body.viewer-page .date-rail .date-item.current * { color: inherit; }
