 <body class="viewer-page"><a class="skip-link" href="#main-content">Skip to main content</a><aside class="viewer-sidebar"><div class="side-project"><div class="project-thumb">⌂</div><strong>{{ project }}</strong><span>Construction project</span></div><nav class="side-nav">{% for key,label,icon in [('map','Map','⌖'),('media','Videos','▧'),('photos','Photos','▣')] %}<a class="{% if tab==key %}selected{% endif %}" href="{{ url_for('shared_project',token=share_token,tab=key) }}"><span>{{ icon }}</span>{{ label }}</a>{% endfor %}</nav><a class="viewer-logo-foot civ-brand" href="/" aria-label="Capture IV home">{{ civ_logo('light', 'Capture Intelligence Visualized') }}</a><div class="side-bottom"><span class="avatar">PV</span><span>Client Viewer<small>PROJECT VIEW · READ ONLY</small></span></div><nav class="viewer-legal" aria-label="Legal and company information"><a href="{{ config.get('MARKETING_SITE_URL', 'https://captureiv.com').rstrip('/') }}/privacy">Privacy</a><a href="{{ config.get('MARKETING_SITE_URL', 'https://captureiv.com').rstrip('/') }}/terms">Terms</a><a href="{{ config.get('MARKETING_SITE_URL', 'https://captureiv.com').rstrip('/') }}/cookies">Cookies</a><a href="{{ config.get('MARKETING_SITE_URL', 'https://captureiv.com').rstrip('/') }}/accessibility">Accessibility</a></nav></aside><main id="main-content" class="viewer-main"><header class="viewer-header"><div><h1>{{ project }}</h1><nav class="viewer-tabs">{% for key,label in [('map','Map'),('media','Videos'),('photos','Photos')] %}<a class="{% if tab==key %}active{% endif %}" href="{{ url_for('shared_project',token=share_token,tab=key) }}">{{ label }}</a>{% endfor %}</nav></div><div class="header-actions"><label class="viewer-search">⌕ <input id="viewer-search" aria-label="Search project footage" placeholder="Search footage…"></label></div></header>
 {% if tab in ['map','overview'] %}<section class="viewer-workspace"><aside class="date-rail"><h2>Flight Dates</h2>{% for d in dates %}<a class="date-item {% if d==selected_date %}current{% endif %}" href="{{ url_for('shared_project',token=share_token,tab=tab,date=d.isoformat()) }}"><span>{{ d.strftime('%b %d, %Y') }}</span><small>{{ flights|selectattr('date','equalto',d)|list|length }} flights · {{ flight_paths_by_date.get(d.isoformat(), [])|length }} routes</small></a>{% else %}<p class="rail-empty">No flight dates yet.</p>{% endfor %}</aside><section class="site-stage"><div id="viewer-site-map" data-module="{{ site_setup.module }}" data-center-lat="{{ site_setup.center_lat if site_setup.center_lat is not none else map_default_center[0] }}" data-center-lng="{{ site_setup.center_lng if site_setup.center_lng is not none else map_default_center[1] }}" data-zoom="{{ site_setup.zoom or (16 if site_setup.address else 4) }}" data-boundary="{{ site_setup.boundary_json|e }}" data-boundary-name="{{ site_setup.boundary_name|e }}" data-image-url="{% if site_reference and site_setup.module=='image' %}{{ url_for('protected_file',filename=site_reference.filename) }}{% endif %}" data-ortho-url="{% if site_map and site_setup.module=='ortho' %}{{ url_for('protected_file',filename=site_map.filename) }}{% endif %}" data-date="{{ selected_date.isoformat() }}"><div class="stage-toolbar"><span class="stage-label">{{ 'ORTHOMOSAIC' if site_setup.module=='ortho' else ('SITE IMAGE' if site_setup.module=='image' else 'SITE OVERVIEW') }}</span><button type="button" aria-label="Change map layer to satellite" id="viewer-layer-toggle" class="map-toggle" {% if site_setup.module!='map' %}hidden{% endif %}>Satellite</button>{% if dates|length > 1 and site_setup.module=='map' and google_maps_api_key %}<button type="button" id="compare-toggle" class="map-toggle" aria-expanded="false">Compare dates</button>{% endif %}</div><div id="viewer-live-map" aria-label="Interactive project site and flight paths"></div><section id="viewer-compare" class="viewer-compare" hidden aria-label="Compare project routes by date"><div class="compare-controls"><label>First date<select id="compare-date-left" aria-label="First comparison date">{% for d in dates %}<option value="{{ d.isoformat() }}" {% if d==selected_date %}selected{% endif %}>{{ d.strftime('%b %d, %Y') }}</option>{% endfor %}</select></label><label>Compare with<select id="compare-date-right" aria-label="Second comparison date">{% for d in dates %}<option value="{{ d.isoformat() }}" {% if d==compare_date %}selected{% endif %}>{{ d.strftime('%b %d, %Y') }}</option>{% endfor %}</select></label><button type="button" id="compare-close">Close comparison</button></div><div class="compare-maps"><div id="viewer-compare-map-left" aria-label="Map of first selected date"></div><div id="viewer-compare-map-right" aria-label="Map of second selected date"></div></div></section><div id="viewer-map-empty" class="viewer-map-empty" hidden>Project site reference has not been uploaded.</div></div><script id="viewer-flight-paths" type="application/json">{{ flight_paths|tojson }}</script><script id="viewer-flight-paths-by-date" type="application/json">{{ flight_paths_by_date|tojson }}</script><div class="stage-foot">{% if site_setup.boundary_name %}<span class="boundary-name-caption">Site boundary: {{ site_setup.boundary_name }}</span>{% endif %}{% if site_reference %}{{ site_reference.original_filename }}{% else %}{{ site_setup.address or 'Project site' }}{% endif %}</div></section><section class="flight-detail">{% if selected_flight %}<div class="detail-heading"><div><span class="detail-date">{{ selected_flight.date.strftime('%b %d, %Y') }}</span><h2>{{ selected_flight.title }}</h2></div><div class="detail-arrows">{% if day_flights|length>1 %}<a href="{{ url_for('shared_project',token=share_token,tab=tab,date=selected_date.isoformat(),flight=day_flights[(day_flights.index(selected_flight)-1)%day_flights|length].id) }}">‹</a><a href="{{ url_for('shared_project',token=share_token,tab=tab,date=selected_date.isoformat(),flight=day_flights[(day_flights.index(selected_flight)+1)%day_flights|length].id) }}">›</a>{% endif %}</div></div><div class="detail-pills"><span>{{ selected_flight.status|title }}</span><span>{{ selected_flight.area or project }}</span></div><div class="preview-video"><video controls preload="metadata" src="{{ url_for('protected_file',filename=selected_flight.filename) }}"></video></div><dl class="flight-facts"><div><dt>▣ &nbsp; Date</dt><dd>{{ selected_flight.date.strftime('%b %d, %Y') }}</dd></div>{% if selected_flight.captured_at %}<div><dt>◷ &nbsp; Time</dt><dd>{{ selected_flight.captured_at.strftime('%I:%M %p') }}</dd></div>{% endif %}<div><dt>⌖ &nbsp; Direction</dt><dd>{{ selected_flight.direction }}</dd></div>{% if selected_flight.drone %}<div><dt>⬡ &nbsp; Drone</dt><dd>{{ selected_flight.drone }}</dd></div>{% endif %}{% if selected_flight.area %}<div><dt>⌑ &nbsp; Area</dt><dd>{{ selected_flight.area }}</dd></div>{% endif %}</dl>{% if selected_flight.description %}<p class="detail-description">{{ selected_flight.description }}</p>{% endif %}{% if selected_flight.tag_list %}<div class="detail-tags"><span>Tags</span>{% for tag in selected_flight.tag_list %}<b>{{ tag }}</b>{% endfor %}</div>{% endif %}<div class="detail-actions"><a href="{{ url_for('protected_file',filename=selected_flight.filename,download=1) }}">↓ &nbsp; Download Video</a><button class="outline-share" data-share>↗ &nbsp; Share</button></div>{% else %}<div class="no-flight"><span>▧</span><h2>No footage for this date</h2><p>Project footage will appear here after upload.</p></div>{% endif %}</section><div class="filmstrip"><div class="filmstrip-heading"><strong>Flights on {{ selected_date.strftime('%b %d, %Y') }}</strong><span>{{ day_flights|length }} flights</span><div>{% if dates|length>1 %}<a href="{{ url_for('shared_project',token=share_token,tab=tab,date=dates[(dates.index(selected_date)-1)%dates|length].isoformat()) }}">‹</a><a href="{{ url_for('shared_project',token=share_token,tab=tab,date=dates[(dates.index(selected_date)+1)%dates|length].isoformat()) }}">›</a>{% endif %}</div></div><div class="filmstrip-cards">{% for f in day_flights %}<a class="film-card {% if selected_flight and f.id==selected_flight.id %}chosen{% endif %}" href="{{ url_for('shared_project',token=share_token,tab=tab,date=selected_date.isoformat(),flight=f.id) }}"><div><video muted preload="metadata" src="{{ url_for('protected_file',filename=f.filename) }}#t=1"></video><span>{{ f.duration or f.file_size|filesize }}</span></div><strong>{{ f.title }}</strong><small>{{ f.direction }}</small></a>{% else %}<p class="muted">No flights uploaded for this date.</p>{% endfor %}</div></div></section>
 {% elif tab=='timeline' %}<section class="content-tab"><p class="eyebrow">PROJECT HISTORY</p><h2>Flight timeline</h2>{% for d in dates %}<a class="timeline-row" href="{{ url_for('shared_project',token=share_token,tab='map',date=d.isoformat()) }}"><b>{{ d.strftime('%b %d, %Y') }}</b><span>{{ flights|selectattr('date','equalto',d)|list|length }} flights</span>View day →</a>{% else %}<p class="muted">No flights have been added yet.</p>{% endfor %}</section>
