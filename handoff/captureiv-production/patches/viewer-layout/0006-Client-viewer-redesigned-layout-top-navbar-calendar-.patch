+body.viewer-page .viewer-topnav .access-share:active { transform: translateY(0); }
+
+/* ---------- Sidebar ---------------------------------------------------- */
+body.viewer-page .viewer-sidebar {
+  width: clamp(248px, 17vw, 300px);
+  flex: 0 0 clamp(248px, 17vw, 300px);
+  background:
+    linear-gradient(180deg, var(--up-navy-850) 0%, var(--up-navy-900) 100%);
+  border-right: 1px solid var(--up-line-dark);
+  color: var(--up-text-on-dark);
+  box-shadow: inset -1px 0 0 rgba(0, 0, 0, .25);
+}
+
+body.viewer-page .viewer-sidebar-heading {
+  gap: 6px;
+  padding: 22px 20px 18px;
+  border-bottom: 1px solid var(--up-line-dark);
+  background: transparent;
+}
+
+body.viewer-page .viewer-sidebar-heading small {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  color: var(--up-accent-bright);
+  font: 700 10px/1 var(--up-font-body);
+  letter-spacing: .18em;
+}
+
+body.viewer-page .viewer-sidebar-heading small::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--up-accent-bright);
+  box-shadow: 0 0 0 3px rgba(90, 160, 255, .18), 0 0 10px rgba(90, 160, 255, .7);
+}
+
+body.viewer-page .viewer-sidebar-heading strong {
+  color: #fff;
+  font: 750 18px/1.2 var(--up-font-head);
+  letter-spacing: -.01em;
+}
+
+body.viewer-page .viewer-date-rail {
+  padding: 16px 14px;
+  border: 0;
+  background: transparent;
+}
+
+/* Date selector */
+body.viewer-page #flight-dates-toggle {
+  width: 100%;
+  min-height: 46px;
+  gap: 10px;
+  padding: 0 10px 0 14px;
+  border: 1px solid var(--up-line-dark-strong);
+  border-radius: var(--up-radius);
+  background: rgba(255, 255, 255, .04);
+  color: #fff;
+  font: 700 13.5px/1 var(--up-font-head);
