+/* ---------- Map popup positioning fix ---------------------------------- */
+/*
+ * style.css animates .leaflet-popup with a transform-based keyframe. Leaflet
+ * positions popups with an inline transform, so the animation overrode it and
+ * route popups appeared at the map's top-left corner (largely hidden under the
+ * header). Animate the inner wrapper instead so Leaflet keeps the position.
+ */
+body.viewer-page .leaflet-popup { animation: none !important; }
+
+body.viewer-page .leaflet-popup-content-wrapper,
+body.viewer-page .leaflet-popup-tip-container {
+  animation: up-popup-in .22s var(--up-ease) both;
+  transform-origin: 50% 100%;
+}
+
+@keyframes up-popup-in {
+  from { opacity: 0; transform: translateY(6px) scale(.97); }
+  to { opacity: 1; transform: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  body.viewer-page .leaflet-popup-content-wrapper,
+  body.viewer-page .leaflet-popup-tip-container { animation: none !important; }
+}
