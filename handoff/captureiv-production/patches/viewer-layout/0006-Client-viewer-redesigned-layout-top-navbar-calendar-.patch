+  transition: transform var(--up-fast) var(--up-ease), box-shadow var(--up-fast) var(--up-ease), filter var(--up-fast) var(--up-ease);
+}
+
+body.viewer-page .viewer-topnav .access-share span { font-size: 12.5px; }
+
+body.viewer-page .viewer-topnav .access-share:hover {
