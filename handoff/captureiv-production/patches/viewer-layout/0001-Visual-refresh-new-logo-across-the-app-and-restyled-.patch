"></div><section id="viewer-compare" class="viewer-compare" hidden aria-label="Compare project routes by date"><div class="compare-controls"><label>First date<select id="compare-date-left" aria-label="First comparison date">{% for d in dates %}<option value="{{ d.isoformat() }}" {% if d==selected_date %}selected{% endif %}>{{ d.strftime('%b %d, %Y') }}</option>{% endfor %}</select></label><label>Compare with<select id="compare-date-right" aria-label="Second comparison date">{% for d in dates %}<option value="{{ d.isoformat() }}" {% if d==compare_date %}selected{% endif %}>{{ d.strftime('%b %d, %Y') }}</option>{% endfor %}</select></label><button type="button" id="compare-close">Close comparison</button></div><div class="compare-maps"><div id="viewer-compare-map-left" aria-label="Map of first selected date"></div><div id="viewer-compare-map-right" aria-label="Map of second selected date"></div></div></section><div id="viewer-map-empty" class="viewer-map-empty" hidden>Project site reference has not been uploaded.</div></div><script id="viewer-flight-paths" type="application/json">{{ flight_paths|tojson }}</script><script id="viewer-flight-paths-by-date" type="application/json">{{ flight_paths_by_date|tojson }}</script><div class="stage-foot">{% if site_setup.boundary_name %}<span class="boundary-name-caption">Site boundary: {{ site_setup.boundary_name }}</span>{% endif %}{% if site_reference %}{{ site_reference.original_filename }}{% else %}{{ site_setup.address or 'Project site' }}{% endif %}</div></section><section class="flight-detail">{% if selected_flight %}<div class="detail-heading"><div><span class="detail-date">{{ selected_flight.date.strftime('%b %d, %Y') }}</span><h2>{{ selected_flight.title }}</h2></div><div class="detail-arrows">{% if day_flights|length>1 %}<a href="{{ url_for('shared_project',token=share_token,tab=tab,date=selected_date.isoformat(),flight=day_flights[(day_flights.index(selected_flight)-1)%day_flights|length].id) }}">‹</a><a href="{{ url_for('shared_project',token=share_token,tab=tab,date=selected_date.isoformat(),flight=day_flights[(day_flights.index(selected_flight)+1)%day_flights|length].id) }}">›</a>{% endif %}</div></div><div class="detail-pills"><span>{{ selected_flight.status|title }}</span><span>{{ selected_flight.area or project }}</span></div><div class="preview-video"><video controls preload="metadata" src="{{ url_for('protected_file',filename=selected_flight.filename) }}"></video></div><dl class="flight-facts"><div><dt>▣ &nbsp; Date</dt><dd>{{ selected_flight.date.strftime('%b %d, %Y') }}</dd></div>{% if selected_flight.captured_at %}<div><dt>◷ &nbsp; Time</dt><dd>{{ selected_flight.captured_at.strftime('%I:%M %p') }}</dd></div>{% endif %}<div><dt>⌖ &nbsp; Direction</dt><dd>{{ selected_flight.direction }}</dd></div>{% if selected_flight.drone %}<div><dt>⬡ &nbsp; Drone</dt><dd>{{ selected_flight.drone }}</dd></div>{% endif %}{% if selected_flight.area %}<div><dt>⌑ &nbsp; Area</dt><dd>{{ selected_flight.area }}</dd></div>{% endif %}</dl>{% if selected_flight.description %}<p class="detail-description">{{ selected_flight.description }}</p>{% endif %}{% if selected_flight.tag_list %}<div class="detail-tags"><span>Tags</span>{% for tag in selected_flight.tag_list %}<b>{{ tag }}</b>{% endfor %}</div>{% endif %}<div class="detail-actions"><a href="{{ url_for('protected_file',filename=selected_flight.filename,download=1) }}">↓ &nbsp; Download Video</a><button class="outline-share" data-share>↗ &nbsp; Share</button></div>{% else %}<div class="no-flight"><span>▧</span><h2>No footage for this date</h2><p>Project footage will appear here after upload.</p></div>{% endif %}</section><div class="filmstrip"><div class="filmstrip-heading"><strong>Flights on {{ selected_date.strftime('%b %d, %Y') }}</strong><span>{{ day_flights|length }} flights</span><div>{% if dates|length>1 %}<a href="{{ url_for('shared_project',token=share_token,tab=tab,date=dates[(dates.index(selected_date)-1)%dates|length].isoformat()) }}">‹</a><a href="{{ url_for('shared_project',token=share_token,tab=tab,date=dates[(dates.index(selected_date)+1)%dates|length].isoformat()) }}">›</a>{% endif %}</div></div><div class="filmstrip-cards">{% for f in day_flights %}<a class="film-card {% if selected_flight and f.id==selected_flight.id %}chosen{% endif %}" href="{{ url_for('shared_project',token=share_token,tab=tab,date=selected_date.isoformat(),flight=f.id) }}"><div><video muted preload="metadata" src="{{ url_for('protected_file',filename=f.filename) }}#t=1"></video><span>{{ f.duration or f.file_size|filesize }}</span></div><strong>{{ f.title }}</strong><small>{{ f.direction }}</small></a>{% else %}<p class="muted">No flights uploaded for this date.</p>{% endfor %}</div></div></section>
 {% elif tab=='timeline' %}<section class="content-tab"><p class="eyebrow">PROJECT HISTORY</p><h2>Flight timeline</h2>{% for d in dates %}<a class="timeline-row" href="{{ url_for('shared_project',token=share_token,tab='map',date=d.isoformat()) }}"><b>{{ d.strftime('%b %d, %Y') }}</b><span>{{ flights|selectattr('date','equalto',d)|list|length }} flights</span>View day →</a>{% else %}<p class="muted">No flights have been added yet.</p>{% endfor %}</section>
 {% elif tab=='photos' %}<section class="content-tab client-photos"><p class="eyebrow">PROJECT SITE PHOTOS</p><h2>Photos &amp; locations</h2>{% if site_reference %}<div class="client-photo-map"><img src="{{ url_for('protected_file',filename=site_reference.filename) }}" alt="{{ project }} site reference image"><svg viewBox="0 0 1000 620" preserveAspectRatio="none" aria-label="Photo coverage areas and locations">{% for area in photo_area_data %}<polygon points="{% for x,y in area.points %}{{ x }},{{ y }} {% endfor %}"/><text x="{{ area.points[0][0] }}" y="{{ area.points[0][1] }}">{{ area.label }}</text>{% endfor %}{% for pin in photo_pin_data %}<circle cx="{{ pin.x }}" cy="{{ pin.y }}" r="12"><title>{{ pin.label }}</title></circle>{% endfor %}</svg></div>{% else %}<p class="muted">A site reference image has not been added yet.</p>{% endif %}<div class="client-photo-grid">{% for pin in photo_pin_data %}{% for photo in pin.photos %}<article class="media-tile"><a href="{{ photo.url }}" target="_blank" rel="noopener"><img src="{{ photo.url }}" alt="{{ photo.name }}" loading="lazy"></a><strong>{{ pin.label }}</strong><span>{{ photo.name }}</span><a class="button secondary small" href="{{ photo.url }}?download=1">Download photo</a></article>{% endfor %}{% else %}<p class="muted">No project photos have been added yet.</p>{% endfor %}</div></section>{% elif tab=='media' %}<section class="content-tab"><p class="eyebrow">CLIENT PROJECT FOOTAGE</p><h2>Drone footage</h2><div class="media-grid">{% for f in flights %}<article class="media-tile"><video controls preload="metadata" aria-label="{{ f.title }}" src="{{ url_for('protected_file',filename=f.filename) }}"></video><strong>{{ f.title }}</strong><span>{{ f.date.strftime('%b %d, %Y') }} · {{ f.direction }}{% if f.area %} · {{ f.area }}{% endif %}</span><a class="button secondary small" href="{{ url_for('protected_file',filename=f.filename,download=1) }}">Download footage</a></article>{% else %}<p class="muted">No footage has been added to this project yet.</p>{% endfor %}</div></section>
