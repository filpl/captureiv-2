diff --git a/static/viewer-refresh.css b/static/viewer-refresh.css
new file mode 100644
index 0000000..ab23d19
--- /dev/null
+++ b/static/viewer-refresh.css
@@ -0,0 +1,124 @@
+/* ==========================================================================
+   Capture IV project viewer refresh (visual only)
+   Restyles the existing client viewer markup: charcoal top bar, white
+   sidebar, Plus Jakarta Sans text, Geist navigation, softer cards. The logo
+   lives at the bottom of the sidebar. No markup, permissions or behaviour
+   change here.
+   ========================================================================== */
+@font-face { font-family: 'Plus Jakarta Sans'; font-style: normal; font-weight: 400; font-display: swap; src: url('fonts/plus-jakarta-sans/plus-jakarta-sans-latin-400-normal.woff2') format('woff2'); }
+@font-face { font-family: 'Plus Jakarta Sans'; font-style: normal; font-weight: 500; font-display: swap; src: url('fonts/plus-jakarta-sans/plus-jakarta-sans-latin-500-normal.woff2') format('woff2'); }
+@font-face { font-family: 'Plus Jakarta Sans'; font-style: normal; font-weight: 600; font-display: swap; src: url('fonts/plus-jakarta-sans/plus-jakarta-sans-latin-600-normal.woff2') format('woff2'); }
+@font-face { font-family: 'Plus Jakarta Sans'; font-style: normal; font-weight: 700; font-display: swap; src: url('fonts/plus-jakarta-sans/plus-jakarta-sans-latin-700-normal.woff2') format('woff2'); }
+@font-face { font-family: 'Geist'; font-style: normal; font-weight: 500; font-display: swap; src: url('fonts/geist/geist-sans-latin-500-normal.woff2') format('woff2'); }
+@font-face { font-family: 'Geist'; font-style: normal; font-weight: 600; font-display: swap; src: url('fonts/geist/geist-sans-latin-600-normal.woff2') format('woff2'); }
+
+body.viewer-page {
+  --vr-char-900: #15171b;
+  --vr-char-800: #1d2025;
+  --vr-char-700: #2a2e35;
+  --vr-line: #e3e7ee;
+  --vr-line-dark: rgba(255, 255, 255, .09);
+  --vr-text: #1b2230;
+  --vr-muted: #667085;
+  --vr-blue: #2f80ff;
+  --vr-blue-soft: #eaf2ff;
+  --vr-bg: #f3f5f9;
+  --vr-head: 103px;
+  background: var(--vr-bg);
+  color: var(--vr-text);
+  font-family: 'Plus Jakarta Sans', 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+body.viewer-page :is(h1, h2, h3, strong, button, input, select) { font-family: inherit; }
+
+/* ---------- Sidebar: white column; its top band continues the charcoal bar */
+body.viewer-page .viewer-sidebar {
+  background: #fff;
+  color: var(--vr-text);
+  border-right: 1px solid var(--vr-line);
+}
+body.viewer-page .side-project {
+  height: var(--vr-head);
+  flex: 0 0 var(--vr-head);
+  align-content: center;
+  padding: 0 18px;
+  background: linear-gradient(180deg, var(--vr-char-800) 0%, var(--vr-char-900) 100%);
+  border-bottom: 1px solid var(--vr-line-dark);
+  color: #fff;
+}
+body.viewer-page .side-project .project-thumb {
+  width: 30px; height: 30px; display: grid; place-items: center; border-radius: 8px;
+  background: rgba(47, 128, 255, .16); color: #8fb8ff; font-size: 15px;
+}
+body.viewer-page .side-project strong { font-size: 14px; font-weight: 700; letter-spacing: -.01em; color: #fff; }
+body.viewer-page .side-project span { color: #9aa3b2; font-size: 11.5px; }
+body.viewer-page .side-nav { padding: 14px 10px 0; gap: 4px; }
+body.viewer-page .side-nav a { color: #3d4656; border-radius: 9px; font-weight: 500; }
+body.viewer-page .side-nav a span { color: #8a94a6; }
+body.viewer-page .side-nav a:hover { background: #f3f6fb; color: var(--vr-text); }
+body.viewer-page .side-nav a.selected { background: var(--vr-blue-soft); color: #1d5fd6; font-weight: 600; }
+body.viewer-page .side-nav a.selected span { color: var(--vr-blue); }
+body.viewer-page .viewer-logo-foot { margin: auto 18px 0; padding: 16px 0 12px; border-top: 1px solid var(--vr-line); text-decoration: none; }
+body.viewer-page .viewer-logo-foot .civ-logo { font-size: 17px; }
+body.viewer-page .viewer-logo-foot .civ-tag { font-size: 7.5px; letter-spacing: .13em; opacity: .7; }
+body.viewer-page .side-bottom { margin-top: 0; border-top: 1px solid var(--vr-line); color: var(--vr-text); }
+body.viewer-page .side-bottom .avatar { background: var(--vr-blue-soft); color: #1d5fd6; }
+body.viewer-page .side-bottom small { color: var(--vr-muted); }
+body.viewer-page .viewer-legal a { color: var(--vr-muted); }
+
+/* ---------- Header: charcoal bar with white title and Geist tabs */
+body.viewer-page .viewer-header {
+  height: var(--vr-head);
+  flex-basis: var(--vr-head);
+  background: linear-gradient(180deg, var(--vr-char-800) 0%, var(--vr-char-900) 100%);
+  border-bottom: 1px solid var(--vr-line-dark);
+  color: #fff;
+  position: relative;
+}
+body.viewer-page .viewer-header::after {
+  content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(90, 160, 255, .5) 25%, rgba(90, 160, 255, .12) 65%, transparent);
+}
+body.viewer-page .viewer-header h1 { color: #fff; font-weight: 700; letter-spacing: -.015em; }
+body.viewer-page .viewer-tabs a {
+  color: #aab2c0; font-family: 'Geist', 'Plus Jakarta Sans', system-ui, sans-serif; font-weight: 500; font-size: 13.5px;
+}
+body.viewer-page .viewer-tabs a:hover { color: #fff; }
+body.viewer-page .viewer-tabs a.active { color: #fff; font-weight: 600; }
+body.viewer-page .viewer-tabs a.active::after { background: var(--vr-blue); height: 2px; border-radius: 2px; }
+body.viewer-page .viewer-search {
+  display: inline-flex; align-items: center; gap: 8px; padding: 0 12px; height: 36px;
+  border: 1px solid rgba(255, 255, 255, .12); border-radius: 9px; background: rgba(255, 255, 255, .06); color: #aab2c0;
+}
+body.viewer-page .viewer-search input { background: transparent; border: 0; outline: 0; color: #fff; font-size: 13px; }
+body.viewer-page .viewer-search input::placeholder { color: #8a94a6; }
+
+/* ---------- Workspace panels */
+body.viewer-page .date-rail { background: #fff; border-right: 1px solid var(--vr-line); }
+body.viewer-page .date-rail h2 { font-weight: 700; letter-spacing: -.01em; }
+body.viewer-page .date-rail a, body.viewer-page .date-rail button { border-radius: 9px; }
+body.viewer-page .site-stage { background: #e7ebf1; margin: 10px 10px 0 10px; border-radius: 14px; box-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 10px 26px rgba(16, 24, 40, .07); }
+body.viewer-page .stage-toolbar .stage-label,
+body.viewer-page .stage-toolbar .map-toggle {
+  border-radius: 8px; background: rgba(255, 255, 255, .92); box-shadow: 0 2px 8px rgba(16, 24, 40, .12);
+  font-family: 'Geist', 'Plus Jakarta Sans', sans-serif;
+}
+body.viewer-page .flight-detail { background: #fff; border-left: 1px solid var(--vr-line); }
+body.viewer-page .flight-detail h2 { font-weight: 700; letter-spacing: -.015em; }
+body.viewer-page .detail-pills span { border-radius: 999px; }
+body.viewer-page .preview-video, body.viewer-page .preview-video video { border-radius: 12px; overflow: hidden; }
+body.viewer-page .flight-detail .button,
+body.viewer-page .flight-detail a.button { border-radius: 9px; background: var(--vr-char-800); border-color: var(--vr-char-800); }
+body.viewer-page .outline-share { border-radius: 9px; }
+body.viewer-page .filmstrip { background: #fff; border-top: 1px solid var(--vr-line); margin: 10px 10px 0; border-radius: 14px 14px 0 0; }
+body.viewer-page .filmstrip-heading strong { font-weight: 700; }
+body.viewer-page .filmstrip-cards > a, body.viewer-page .filmstrip-cards > div { border-radius: 10px; }
+body.viewer-page .media-tile { border-radius: 12px; overflow: hidden; box-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 6px 18px rgba(16, 24, 40, .06); }
+body.viewer-page .viewer-compare { border-radius: 14px; }
+
+/* ---------- Narrow screens: production collapses the sidebar to icons */
+@media (max-width: 900px) {
+  body.viewer-page .viewer-logo-foot { display: none; }
+  body.viewer-page .side-project { padding: 0 10px; justify-items: center; }
+  body.viewer-page .side-project strong, body.viewer-page .side-project span { display: none; }
+}
