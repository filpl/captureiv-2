# Copy values into your local environment or deployment secret manager.
# Do not commit populated credentials.
APP_ENV=development
PORT=5009
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-run
DATABASE_URL=sqlite:///drone_portal.db
MARKETING_SITE_URL=http://127.0.0.1:5173/
SESSION_COOKIE_SECURE=0
MAX_CONTENT_LENGTH=8589934592

# Optional email verification and password recovery. Local development works without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Capture IV <no-reply@example.com>
ENTERPRISE_INQUIRY_EMAIL=

# Optional Stripe TEST mode only. Do not use live credentials during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=7

# Local storage remains active until R2 is explicitly configured.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
