# Template only. Production startup intentionally fails until all required values
# are supplied privately through the deployment environment or secret manager.
APP_ENV=production
PORT=5000
SECRET_KEY=
ADMIN_USERNAME=platform-owner
ADMIN_PASSWORD=
DATABASE_URL=
PUBLIC_APP_URL=
MARKETING_SITE_URL=https://www.example.com/
SESSION_COOKIE_SECURE=1
TRUSTED_PROXY_COUNT=1
MAX_CONTENT_LENGTH=8589934592

# Account verification, password recovery, and enterprise inquiry delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Capture IV <no-reply@example.com>
ENTERPRISE_INQUIRY_EMAIL=

# Live billing is enabled only in APP_ENV=production. Configure after approval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=7

# Set to 1 only after the Platform Owner approves the final customer-facing policies.
BILLING_TERMS_APPROVED=0
DATA_RETENTION_POLICY_APPROVED=0

# Production uploads require private Cloudflare R2 storage.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
